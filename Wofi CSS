nano ~/.config/wofi/style.css

window {
    margin: 0px;
    border: 2px solid #595959;
    background-color: rgba(0, 0, 0, 0.5);
    font-family: "JetBrainsMono NF", monospace;
    font-size: 14px;
    border-radius: 10px;
}

#input {
    margin: 4px;
    border: none;
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 20px;
}

#inner-box {
    margin: 4px;
    border: none;
    background-color: transparent;
}

#outer-box {
    margin: 4px;
    border: none;
    background-color: transparent;
}

#scroll {
    margin: 0px;
    border: none;
}

#text {
    margin: 4px;
    color: #cdd6f4;
}

#entry:selected {
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 20px;
}

#text:selected {
    color: #ffffff;
}
