nano ~/.config/waybar/config.json

{
    "layer": "top",
    "position": "top",
    "height": 40,
    "margin-top": 8,
    "margin-left": 20,
    "margin-right": 20,
    "spacing": 0,

    "modules-left": ["pulseaudio"],
    "modules-center": ["clock"],
    "modules-right": ["network"],

    "clock": {
        "interval": 1,
        "format": "{:%H:%M}",
        "format-alt": "{:%A, %d de %B de %Y}",
        "tooltip": false
    },

    "pulseaudio": {
        "format": "{volume}%",
        "on-click": "pavucontrol",
        "tooltip": false
    },

    "network": {
        "format-wifi": "   {essid}",
        "format-ethernet": "   Wired",
        "format-disconnected": "   Disconnected"
    }
}
