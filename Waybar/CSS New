nano ~/.config/waybar/style.css

window#waybar {
    background-color: rgba(0, 0, 0, 0.5);
    border-radius: 20px;
    color: #FFFFFF;
    border: 2px solid rgba(89, 89, 89, 0.67);
}

#clock,
#network,
#pulseaudio {
    padding: 0 14px;
    margin: 4px;
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 20px;
}

#clock {
    color: #A66FB5;
}

#pulseaudio {
    color: #6FC276;
}

#network {
    color: #77B1D4;
}
